# === Почтовый ящик ===
# Хост IMAP-сервера (gmail, yandex, mail.ru и т.д.)
IMAP_HOST=imap.gmail.com

# Порт (стандарт для SSL/TLS)
IMAP_PORT=993

# Email-адрес, с которого приходят выписки
IMAP_USER=your_email@gmail.com

# Пароль приложения (не основной пароль от аккаунта!)
IMAP_PASS=your_app_password_here

# === Локальное хранение ===
# Полный путь к папке для выписок (создаётся автоматически)
DOWNLOAD_DIR=C:\SberStatements

# === Расписание ===
# Время ежедневной проверки (24ч формат)
SUCCESS_TIME=10:00

# Интервал повтора при сетевых ошибках (в часах)
RETRY_HOURS=3